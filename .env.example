APP_NAME=Barbearia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel

# Usuário runtime da aplicação — apenas SELECT, INSERT, UPDATE, DELETE
# DB_USERNAME=app_user
# DB_PASSWORD=

# Usuário exclusivo para migrations — tem CREATE, DROP, ALTER, INDEX
# Usado apenas no Deploy Script: php artisan migrate --database=mysql_migrator
# DB_MIGRATE_USERNAME=app_migrator
# DB_MIGRATE_PASSWORD=

# Superusuário (só necessário para rodar: php artisan setup:db-permissions)
# DB_SUPER_USERNAME=forge
# DB_SUPER_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.seuservidor.com
MAIL_PORT=587
MAIL_USERNAME=seu@email.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@seudominioaqui.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# --- ADMIN CREDENTIALS (NEVER COMMIT REAL PASSWORDS) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@barbearia.local
ADMIN_PASSWORD=ChangeMe@12345

# --- SANCTUM TOKEN EXPIRATION (minutes) ---
SANCTUM_EXPIRATION=1440

# --- RATE LIMITING ---
RATE_LIMIT_AUTH=5

# --- CORS CONFIGURATION ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://seudominio.com.br

# --- MERCADO PAGO ---
# Pegue suas credenciais em: https://www.mercadopago.com.br/developers/panel
# Webhook Secret encontra-se em: Panel > Configuração > Webhooks
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=